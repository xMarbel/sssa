{
  "name": "vilo-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "VILO local desktop beta",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.vilo.desktop",
    "productName": "VILO",
    "files": [
      "main.js",
      "backend/static/vilo-icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "backend-dist/vilo-server",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "vilo.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VILO",
      "artifactName": "VILO-Setup-${version}.${ext}"
    }
  }
}